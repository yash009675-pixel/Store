# ---------------------------------------------------------------------------
# APNA STORE — environment
#
# Copy to `.env` and fill in to connect the real catalogue.
# Only the PUBLISHABLE anon key belongs here. A service-role key must NEVER
# be placed in a VITE_* variable — everything prefixed VITE_ is compiled
# into the browser bundle and is readable by anyone.
# ---------------------------------------------------------------------------

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
